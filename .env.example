# ── Backend Server Configuration ─────────────────────────────────────────────
# These variables are read by the Node backend (backend/index.ts).
PORT=3000
DB_PATH=./data/modigitalevents.db
NODE_ENV=development

# ── Mobile App Configuration ─────────────────────────────────────────────────
# The mobile app does NOT read environment variables. Set the backend URL in
# lib/config.ts (SERVER_URL) before building:
#   Android emulator:               http://10.0.2.2:3000
#   iOS simulator:                  http://localhost:3000
#   Physical device (same Wi-Fi):   http://192.168.X.X:3000
#   Production:                     https://your-backend.example.com
